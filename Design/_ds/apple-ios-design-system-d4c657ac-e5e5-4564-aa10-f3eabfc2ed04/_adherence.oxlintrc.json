{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/controls/**",
              "components/dialogs/**",
              "components/indicators/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/store-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SF Pro Display|SF Pro Text|Inter))/i]",
        "message": "Font not provided by the design system. Available: SF Pro Display, SF Pro Text, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|title|message|actions|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: variant, tone, title, message, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:inline|message)$/]",
        "message": "<Alert> variant must be one of 'inline' | 'message'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:error|success|info)$/]",
        "message": "<Alert> tone must be one of 'error' | 'success' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|count|icon|color|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, count, icon, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:standard|count|icon)$/]",
        "message": "<Badge> variant must be one of 'standard' | 'count' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|error|success)$/]",
        "message": "<Badge> color must be one of 'primary' | 'error' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|onDark|disabled|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, onDark, disabled, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondaryPill|darkUtility|pearlCapsule|storeHero|iconCircular|textLink)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondaryPill' | 'darkUtility' | 'pearlCapsule' | 'storeHero' | 'iconCircular' | 'textLink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|surface|eyebrow|title|subtitle|media|actions|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: kind, surface, eyebrow, title, subtitle, media, actions, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:tile|utility)$/]",
        "message": "<Card> kind must be one of 'tile' | 'utility'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:light|parchment|dark|dark2|dark3)$/]",
        "message": "<Card> surface must be one of 'light' | 'parchment' | 'dark' | 'dark2' | 'dark3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|label|helper|disabled|onChange|variant|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, label, helper, disabled, onChange, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:control|item)$/]",
        "message": "<Checkbox> variant must be one of 'control' | 'item'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|removable|onClick|onRemove|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, selected, removable, onClick, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:inset|onDark|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: inset, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onDark|children|key|ref|className|style|children)$/]",
        "message": "<Link> doesn't accept that prop. Declared props: href, onDark, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|chevron|dense|onClick|key|ref|className|style|children)$/]",
        "message": "<ListItem> doesn't accept that prop. Declared props: label, value, chevron, dense, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PasswordInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|error|key|ref|className|style|children)$/]",
        "message": "<PasswordInput> doesn't accept that prop. Declared props: value, onChange, label, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinCodeInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:length|values|onChange|key|ref|className|style|children)$/]",
        "message": "<PinCodeInput> doesn't accept that prop. Declared props: length, values, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|label|helper|disabled|onSelect|variant|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: selected, label, helper, disabled, onSelect, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:control|item)$/]",
        "message": "<Radio> variant must be one of 'control' | 'item'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|disabled|onChange|label|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: on, disabled, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|key|ref|className|style|children)$/]",
        "message": "<TabBarItem> doesn't accept that prop. Declared props: label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|removable|onRemove|tone|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: label, removable, onRemove, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|error)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|label|rows|error|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: value, onChange, placeholder, label, rows, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|variant|label|error|icon|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: value, onChange, placeholder, variant, label, error, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:standard|search)$/]",
        "message": "<TextInput> variant must be one of 'standard' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|left|center|right|key|ref|className|style|children)$/]",
        "message": "<ToolBar> doesn't accept that prop. Declared props: variant, left, center, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolBar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:globalNav|subNav|stickyBottom)$/]",
        "message": "<ToolBar> variant must be one of 'globalNav' | 'subNav' | 'stickyBottom'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
